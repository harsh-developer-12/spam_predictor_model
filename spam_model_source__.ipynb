import numpy as np 
import pandas as pd
import matplotlib.pyplot as plt 
from sklearn.model_selection import train_test_split 
from sklearn.pipeline import Pipeline 
from sklearn.feature_extraction.text import TfidfVectorizer 
from sklearn.linear_model import LogisticRegression 
from sklearn.metrics import (
    accuracy_score, precision_score, recall_score, 
    f1_score, confusion_matrix, roc_auc_score, classification_report
) 
import joblib
print("leb done")


data = pd.read_csv("/kaggle/input/datasets/gajnabi/spam-or-not-sp/email_spam_binary_classification_800_rows.csv")
print("load done")

print(data.head())
print(data.shape)






print("missing value \n" , data.isnull().sum()) 

# duplicates 

print("duplicates \n" , data[data.duplicated()])  # duplicated ().sum() 





df = data.drop_duplicates().copy()
print("remove duplicate \n" , df) 






df["sender"] = df["sender"].fillna("")
df["subject"] = df["subject"].fillna("")
df["email_text"] = df["email_text"].fillna("")

print("clean data \n", df.shape)
print("missing \n" , df.duplicated().sum()) 
print("null value \n " ,df.isnull().sum()) 





x = df["subject"] +"  " + df["email_text"]         # features 
y = df["label"]                                    # target 
print(x.head())
print(y.value_counts()) 





visual = y.value_counts() 
visual.plot(kind="bar") 
plt.title("spam vs not spam")
plt.xlabel("Email")
plt.ylabel("num of email") 
plt.show() 





x_train , x_test , y_train , y_test = train_test_split(
    x ,
    y ,
    test_size = 0.2, 
    random_state = 42, 
    stratify = y
)
print ("training sample:" , len(x_train))
print ("testing sample : " ,len(x_test)) 


model = Pipeline([
    ("text convert into numerical" , TfidfVectorizer()),
    ("classification model" , LogisticRegression(max_iter = 1000)) 
]) 

model.fit(x_train ,y_train) 



y_prediction = model.predict(x_test) 
print("model pridiction ") 

print ("\n confussion matrix") 
print(confusion_matrix(y_test , y_prediction)) 

print("\n Prcision" , precision_score(y_test , y_prediction ,pos_label="spam", zero_division=0)*100 , "%") 
print("\n recall " , recall_score (y_test , y_prediction ,pos_label="spam", zero_division=0)*100,"%") 
print("\n f1-score" , f1_score(y_test , y_prediction ,pos_label="spam", zero_division=0)*100 , "%")
accuracy = accuracy_score(y_test , y_prediction) 
print("accuracy of model" , accuracy*100 , "%") 

if hasattr(model, "predict_proba"):
    y_prob = model.predict_proba(x_test)[:, 1]   # probability 
    print("ROC-AUC:", roc_auc_score(y_test, y_prob))
    






